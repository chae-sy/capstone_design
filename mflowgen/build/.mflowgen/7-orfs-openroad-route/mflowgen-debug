export design_name=gcd
export clock_period=2.0
export orfs_platform=nangate45
export orfs_image=mflowgen/openroad-flow-scripts-base:2024-0621-f0caba6

# Debug

echo -e "\n- Loading orfs docker image ...\n"
docker load -i inputs/orfs-docker-image.tar
